class Game {
   field Board board;
   field Player player;
   field boolean running;
   field int speedLevel;
   field int speedDelay;
   field int normalSpeedDelay;
   field int moveWait;
   field int score;
   field int boostTimer;

   constructor Game new() {
      let board = Board.new();
      let player = Player.new(board, 15, 15);
      let running = true;
      let speedLevel = 2;
      let speedDelay = 1;
      let normalSpeedDelay = 1;
      let moveWait = 0;
      let score = 0;
      let boostTimer = 0;
      return this;
   }

   method void run() {
      var int key;

      do Screen.clearScreen();
      do board.drawAll();
      do player.draw();
      do drawHud();

      while (running) {
         let key = Keyboard.keyPressed();

         if (key = 140) {
            let running = false;
         }

         do updateRestart(key);
         do updateSpeed(key);
         do tryMovePlayer(key);
         do updateBoostTimer();

         do Sys.wait(45);
      }

      return;
   }

   method void updateRestart(int key) {
      if (key = 82) {
         do restartGame();
      }
      if (key = 114) {
         do restartGame();
      }
      return;
   }

   method void restartGame() {
      let speedLevel = 2;
      let normalSpeedDelay = 1;
      let speedDelay = normalSpeedDelay;
      let moveWait = 0;
      let score = 0;
      let boostTimer = 0;

      do board.resetItems();
      do player.resetPosition(15, 15);
      do Screen.clearScreen();
      do board.drawAll();
      do player.draw();
      do drawHud();

      return;
   }

   method void updateSpeed(int key) {
      if (key = 49) {
         let speedLevel = 1;
         let normalSpeedDelay = 2;
         if (boostTimer = 0) {
            let speedDelay = normalSpeedDelay;
         }
         do drawHud();
      }
      if (key = 50) {
         let speedLevel = 2;
         let normalSpeedDelay = 1;
         if (boostTimer = 0) {
            let speedDelay = normalSpeedDelay;
         }
         do drawHud();
      }
      if (key = 51) {
         let speedLevel = 3;
         let normalSpeedDelay = 0;
         if (boostTimer = 0) {
            let speedDelay = normalSpeedDelay;
         }
         do drawHud();
      }
      return;
   }

   method void tryMovePlayer(int key) {
      var boolean moved;

      if (moveWait > 0) {
         let moveWait = moveWait - 1;
         return;
      }

      let moved = false;

      if (key = 130) {
         let moved = player.move(0, -1);
      }
      if (key = 131) {
         let moved = player.move(-1, 0);
      }
      if (key = 132) {
         let moved = player.move(0, 1);
      }
      if (key = 133) {
         let moved = player.move(1, 0);
      }

      if (moved) {
         do collectCurrentCell();
         let moveWait = speedDelay;
      }

      return;
   }

   method void collectCurrentCell() {
      var int item;

      let item = board.collectAt(player.getRow(), player.getCol());

      if (item = 1) {
         let score = score + 10;
         do drawHud();
      }

      if (item = 2) {
         let score = score + 50;
         let boostTimer = 80;
         let speedDelay = 0;
         do drawHud();
      }

      return;
   }

   method void updateBoostTimer() {
      if (boostTimer > 0) {
         let boostTimer = boostTimer - 1;
         if (boostTimer = 0) {
            let speedDelay = normalSpeedDelay;
            do drawHud();
         }
      }

      return;
   }

   method void drawHud() {
      do Screen.setColor(false);
      do Screen.drawRectangle(0, 0, 511, 31);
      do Screen.setColor(true);
      do Output.moveCursor(0, 0);
      do printText();
      do Output.printInt(speedLevel);
      do printScoreText();
      do Output.printInt(score);
      if (boostTimer > 0) {
         do printBoostText();
      }
      return;
   }

   method void printText() {
      do Output.printChar(77);
      do Output.printChar(111);
      do Output.printChar(118);
      do Output.printChar(105);
      do Output.printChar(109);
      do Output.printChar(105);
      do Output.printChar(101);
      do Output.printChar(110);
      do Output.printChar(116);
      do Output.printChar(111);
      do Output.printChar(32);
      do Output.printChar(101);
      do Output.printChar(115);
      do Output.printChar(116);
      do Output.printChar(114);
      do Output.printChar(117);
      do Output.printChar(99);
      do Output.printChar(116);
      do Output.printChar(117);
      do Output.printChar(114);
      do Output.printChar(97);
      do Output.printChar(108);
      do Output.printChar(32);
      do Output.printChar(45);
      do Output.printChar(32);
      do Output.printChar(86);
      do Output.printChar(101);
      do Output.printChar(108);
      do Output.printChar(58);
      do Output.printChar(32);
      return;
   }

   method void printScoreText() {
      do Output.printChar(32);
      do Output.printChar(80);
      do Output.printChar(116);
      do Output.printChar(115);
      do Output.printChar(58);
      do Output.printChar(32);
      return;
   }

   method void printBoostText() {
      do Output.printChar(32);
      do Output.printChar(73);
      do Output.printChar(109);
      do Output.printChar(112);
      do Output.printChar(117);
      do Output.printChar(108);
      do Output.printChar(115);
      do Output.printChar(111);
      return;
   }

   method void dispose() {
      do player.dispose();
      do board.dispose();
      do Memory.deAlloc(this);
      return;
   }
}

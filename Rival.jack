class Rival {
   field Board board;
   field int row;
   field int col;

   constructor Rival new(Board gameBoard, int startRow, int startCol) {
      let board = gameBoard;
      let row = startRow;
      let col = startCol;
      return this;
   }

   method int getRow() {
      return row;
   }

   method int getCol() {
      return col;
   }

   method boolean isAt(int testRow, int testCol) {
      if ((row = testRow) & (col = testCol)) {
         return true;
      }
      return false;
   }

   method void resetPosition(int startRow, int startCol) {
      let row = startRow;
      let col = startCol;
      return;
   }

   method void draw() {
      var int x;
      var int y;

      let x = board.xOf(col);
      let y = board.yOf(row);

      do Screen.setColor(false);
      do Screen.drawRectangle(x + 2, y + 1, x + 7, y + 2);
      do Screen.drawRectangle(x + 1, y + 3, x + 8, y + 6);
      do Screen.drawRectangle(x + 2, y + 7, x + 3, y + 8);
      do Screen.drawRectangle(x + 6, y + 7, x + 7, y + 8);
      do Screen.setColor(true);
      do Screen.drawRectangle(x + 3, y + 4, x + 3, y + 4);
      do Screen.drawRectangle(x + 6, y + 4, x + 6, y + 4);

      return;
   }

   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }
}

class Board {
   field int rows;
   field int cols;
   field int cellSize;
   field int originX;
   field int originY;
   field Array items;

   constructor Board new() {
      let rows = 21;
      let cols = 31;
      let cellSize = 10;
      let originX = 101;
      let originY = 38;
      let items = Array.new(rows * cols);
      do resetItems();
      return this;
   }

   method int xOf(int col) {
      return originX + (col * cellSize);
   }

   method int yOf(int row) {
      return originY + (row * cellSize);
   }

   method boolean canEnter(int row, int col) {
      if (row < 0) {
         return false;
      }
      if (col < 0) {
         return false;
      }
      if (row > (rows - 1)) {
         return false;
      }
      if (col > (cols - 1)) {
         return false;
      }
      if (isWall(row, col)) {
         return false;
      }
      return true;
   }

   method boolean isWall(int row, int col) {
      if (row = 0) {
         return true;
      }
      if (row = (rows - 1)) {
         return true;
      }
      if (col = 0) {
         return true;
      }
      if (col = (cols - 1)) {
         return true;
      }

      if ((row = 2) & (col > 2) & (col < 7)) {
         return true;
      }
      if ((row = 2) & (col > 9) & (col < 14)) {
         return true;
      }
      if ((row = 2) & (col > 16) & (col < 21)) {
         return true;
      }
      if ((row = 2) & (col > 23) & (col < 28)) {
         return true;
      }
      if ((row = 4) & (col > 2) & (col < 7)) {
         return true;
      }
      if ((row = 4) & (col > 9) & (col < 21)) {
         return true;
      }
      if ((row = 4) & (col > 23) & (col < 28)) {
         return true;
      }
      if ((row > 1) & (row < 5) & (col = 15)) {
         return true;
      }
      if ((row = 6) & (col > 1) & (col < 7)) {
         return true;
      }
      if ((row = 6) & (col > 9) & (col < 13)) {
         return true;
      }
      if ((row = 6) & (col > 18) & (col < 22)) {
         return true;
      }
      if ((row = 6) & (col > 23) & (col < 29)) {
         return true;
      }
      if ((row = 8) & (col > 2) & (col < 8)) {
         return true;
      }
      if ((row = 8) & (col > 22) & (col < 28)) {
         return true;
      }
      if ((row = 10) & (col > 2) & (col < 7)) {
         return true;
      }
      if ((row = 10) & (col > 23) & (col < 28)) {
         return true;
      }
      if ((row > 10) & (row < 14) & (col = 4)) {
         return true;
      }
      if ((row > 10) & (row < 14) & (col = 26)) {
         return true;
      }
      if ((row = 14) & (col > 2) & (col < 8)) {
         return true;
      }
      if ((row = 14) & (col > 10) & (col < 14)) {
         return true;
      }
      if ((row = 14) & (col > 16) & (col < 20)) {
         return true;
      }
      if ((row = 14) & (col > 22) & (col < 28)) {
         return true;
      }
      if ((row > 14) & (row < 18) & (col = 8)) {
         return true;
      }
      if ((row > 14) & (row < 18) & (col = 22)) {
         return true;
      }
      if ((row = 16) & (col > 5) & (col < 14)) {
         return true;
      }
      if ((row = 16) & (col > 16) & (col < 25)) {
         return true;
      }
      if ((row = 18) & (col > 2) & (col < 11)) {
         return true;
      }
      if ((row = 18) & (col > 12) & (col < 18)) {
         return true;
      }
      if ((row = 18) & (col > 19) & (col < 28)) {
         return true;
      }

      return false;
   }

   method void resetItems() {
      var int row;
      var int col;

      let row = 0;
      while (row < rows) {
         let col = 0;
         while (col < cols) {
            if (isWall(row, col)) {
               do setItem(row, col, 0);
            } else {
               do setItem(row, col, 1);
            }
            let col = col + 1;
         }
         let row = row + 1;
      }

      do setItem(15, 15, 0);
      do setItem(19, 15, 2);

      return;
   }

   method int itemAt(int row, int col) {
      return items[(row * cols) + col];
   }

   method void setItem(int row, int col, int value) {
      let items[(row * cols) + col] = value;
      return;
   }

   method int collectAt(int row, int col) {
      var int item;

      let item = itemAt(row, col);
      if (item > 0) {
         do setItem(row, col, 0);
      }

      return item;
   }

   method void drawAll() {
      var int row;
      var int col;

      let row = 0;
      while (row < rows) {
         let col = 0;
         while (col < cols) {
            do drawCell(row, col);
            let col = col + 1;
         }
         let row = row + 1;
      }

      return;
   }

   method void drawCell(int row, int col) {
      var int x;
      var int y;

      let x = xOf(col);
      let y = yOf(row);

      if (isWall(row, col)) {
         do Screen.setColor(false);
         do Screen.drawRectangle(x, y, (x + cellSize) - 1, (y + cellSize) - 1);
      } else {
         do Screen.setColor(true);
         do Screen.drawRectangle(x, y, (x + cellSize) - 1, (y + cellSize) - 1);
         do drawItem(row, col);
      }

      return;
   }

   method void drawItem(int row, int col) {
      var int item;
      var int x;
      var int y;

      let item = itemAt(row, col);
      let x = xOf(col);
      let y = yOf(row);

      if (item = 1) {
         do Screen.setColor(false);
         do Screen.drawRectangle(x + 4, y + 4, x + 5, y + 5);
      }

      if (item = 2) {
         do Screen.setColor(false);
         do Screen.drawRectangle(x + 3, y + 2, x + 6, y + 7);
         do Screen.drawRectangle(x + 2, y + 3, x + 7, y + 6);
         do Screen.setColor(true);
         do Screen.drawRectangle(x + 4, y + 3, x + 5, y + 6);
         do Screen.drawRectangle(x + 3, y + 4, x + 6, y + 5);
      }

      return;
   }

   method void dispose() {
      do items.dispose();
      do Memory.deAlloc(this);
      return;
   }
}
